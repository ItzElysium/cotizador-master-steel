# Copia este archivo como infra/.env y completa los valores. NO lo subas a GitHub (.gitignore lo excluye).
# Las variables SECRETAS van a "secretos" (parámetro @secure de Bicep); el resto a "configuracion".

# ---------------- Empresa (aparece en el PDF y en el agente)
EMPRESA_NOMBRE=Master Steel
EMPRESA_LEMA=Los Maestros del Acero
# Completar con los datos reales:
EMPRESA_RUC=
EMPRESA_DIRECCION=Callao, Perú
EMPRESA_TELEFONO=
EMPRESA_EMAIL=
EMPRESA_WEB=
# Varias cuentas separadas por |
EMPRESA_CUENTAS=BCP US$ 000-0000000-1-00 (CCI ...) | BCP S/ 000-0000000-0-00
EMPRESA_CONDICIONES=Precios en dólares americanos. | Stock sujeto a confirmación al momento de la orden. | Pago contado o según línea de crédito aprobada. | Pesos teóricos referenciales.
EMPRESA_FLETE=Despacho desde nuestro almacén en el Callao; flete a coordinar según zona de entrega.
# Colores tomados del logo (azul y verde de Master Steel)
EMPRESA_COLOR_PRIMARIO=#0168AA
EMPRESA_COLOR_ACENTO=#00A591
HORARIO_ATENCION=lunes a sábado de 8:00 a.m. a 6:00 p.m.
PDF_MARCA=Cotizador IA by DataPrix

# ---------------- Reglas comerciales
MODO_ENVIO=aprobacion
# Números de WhatsApp de los vendedores/administradores (con código de país, sin +), separados por coma
ADMIN_NUMEROS=51999888777
VIGENCIA_HORAS=48
PRECIOS_INCLUYEN_IGV=false
MOSTRAR_SOLES=true
TC_FUENTE=bcrp
TC_SPREAD=0.00
TC_MANUAL=3.75
DESCUENTOS_TIPO_CLIENTE=publico:0,maestro:0.02,ferreteria:0.05,empresa:0.03
DESCUENTOS_VOLUMEN_KG=1000:0.02,5000:0.04
DESCUENTO_MAXIMO=0.08
DIAS_ALERTA_PRECIO=7
DEBOUNCE_SEGUNDOS=6
HUMANO_PAUSA_HORAS=4

# ---------------- WhatsApp Cloud API (Meta)
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v23.0
# Plantilla de utilidad opcional para avisar al vendedor fuera de la ventana de 24 h
WA_PLANTILLA_APROBACION=
WA_PLANTILLA_IDIOMA=es
# Secretos:
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# ---------------- IA
LLM_PROVEEDOR=anthropic
LLM_MODELO=claude-haiku-5-5
# Secreto:
ANTHROPIC_API_KEY=

# Alternativa Azure OpenAI (LLM_PROVEEDOR=azure_openai) y transcripción de audios
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
TRANSCRIPCION_PROVEEDOR=none
AZURE_OPENAI_DEPLOYMENT_TRANSCRIPCION=
# Secreto:
AZURE_OPENAI_API_KEY=
